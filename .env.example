# ==========================================
# ZOMIN FASTFOOD HUB - ENVIRONMENT VARIABLES
# ==========================================

# Server Port (Cloud platforms like Render/Railway automatically inject PORT)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=production

# JWT Authentication Secret Key (CHANGE THIS TO A LONG RANDOM STRING IN CLOUD)
JWT_SECRET=zomin_fastfood_super_secret_jwt_key_2026_production

# SQLite Database Directory & File Path
# In Cloud (Docker/Render/Railway), mount a persistent volume to /app/data
DB_DIR=./data
DB_PATH=./data/fastfood.sqlite

# Default Superadmin Password on First Boot
ADMIN_DEFAULT_PASSWORD=admin123

# Telegram Bot Configuration (Optional for Telegram Bot & TMA)
# Create your bot via @BotFather and paste the HTTP API Token here:
BOT_TOKEN=

# Admin Group or Channel Telegram Chat ID to receive instant order notifications
ADMIN_CHAT_ID=

# Public Web URL of the deployed application (used for Telegram WebApp)
# E.g. https://zomin-fastfood.onrender.com or https://yourdomain.uz
WEB_APP_URL=
